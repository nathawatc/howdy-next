# Keep destination registration and installation together. Every file and empty
# directory uses this wrapper; custom config preservation registers its paths too.
function(howdy_install)
  cmake_parse_arguments(PARSE_ARGV 0 rule "" "DESTINATION" "FILES;TARGETS;DIRECTORY;RUNTIME;LIBRARY;PERMISSIONS;DIRECTORY_PERMISSIONS")
  if(NOT DEFINED rule_DESTINATION OR rule_UNPARSED_ARGUMENTS)
    message(FATAL_ERROR "Unsupported howdy_install rule: ${ARGV}")
  endif()
  if(rule_FILES)
    foreach(source IN LISTS rule_FILES)
      cmake_path(GET source FILENAME name)
      howdy_install_destination(F "${rule_DESTINATION}/${name}")
    endforeach()
  elseif(rule_TARGETS)
    foreach(target IN LISTS rule_TARGETS)
      howdy_install_destination(F "${rule_DESTINATION}/$<TARGET_FILE_NAME:${target}>")
    endforeach()
  elseif("DIRECTORY" IN_LIST ARGV AND NOT rule_DIRECTORY)
    howdy_install_destination(D "${rule_DESTINATION}")
  else()
    message(FATAL_ERROR "Unsupported howdy_install rule: ${ARGV}")
  endif()
  install(${ARGV})
endfunction()

function(howdy_install_destination kind destination)
  cmake_path(ABSOLUTE_PATH destination BASE_DIRECTORY "${CMAKE_INSTALL_PREFIX}" NORMALIZE)
  set_property(GLOBAL APPEND_STRING PROPERTY HOWDY_INSTALL_DESTINATIONS "${kind}${destination}\n")
endfunction()
