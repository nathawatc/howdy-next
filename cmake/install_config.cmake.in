set(_howdy_config_dir "@HOWDY_CONFIG_DIR@")
set(_howdy_config_path "@HOWDY_CONFIG_PATH@")
set(_howdy_packaged_config_path "@HOWDY_PACKAGED_CONFIG_PATH@")
set(_howdy_user_models_dir "@HOWDY_USER_MODELS_DIR@")

if(NOT EXISTS "${_howdy_packaged_config_path}" OR IS_DIRECTORY "${_howdy_packaged_config_path}")
  message(
  FATAL_ERROR
  "Generated Howdy config is missing: ${_howdy_packaged_config_path}. "
  "Build target howdy_packaged_config before installing."
 )
endif()

foreach(directory IN ITEMS "${_howdy_config_dir}" "${_howdy_user_models_dir}")
  set(staged_directory "$ENV{DESTDIR}${directory}")
  if(EXISTS "${staged_directory}" AND NOT IS_DIRECTORY "${staged_directory}")
    message(FATAL_ERROR "Howdy configuration path is not a directory: ${staged_directory}")
  endif()
  if(NOT EXISTS "${staged_directory}")
    file(MAKE_DIRECTORY "${staged_directory}")
    file(CHMOD "${staged_directory}" PERMISSIONS
         OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE)
  endif()
endforeach()

if(NOT EXISTS "$ENV{DESTDIR}${_howdy_config_path}")
  file(INSTALL DESTINATION "${_howdy_config_dir}" TYPE FILE
       FILES "${_howdy_packaged_config_path}"
       FILE_PERMISSIONS OWNER_READ OWNER_WRITE GROUP_READ)
endif()
