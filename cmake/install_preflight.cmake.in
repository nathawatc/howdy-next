if(DEFINED ENV{CMAKE_INSTALL_MODE} AND NOT "$ENV{CMAKE_INSTALL_MODE}" STREQUAL ""
   AND NOT "$ENV{CMAKE_INSTALL_MODE}" STREQUAL "COPY")
  message(FATAL_ERROR "Howdy installs require CMAKE_INSTALL_MODE=COPY")
endif()
if(NOT "$ENV{DESTDIR}" STREQUAL "")
  set(howdy_preflight_emulator)
  if(@CMAKE_CROSSCOMPILING@)
    set(howdy_preflight_emulator [==[@CMAKE_CROSSCOMPILING_EMULATOR@]==])
  endif()
  # Keep the emulator prefix here: howdy_install_preflight is a target binary
  # and must be executable during staged installs when cross-compiling.
  execute_process(
    COMMAND ${howdy_preflight_emulator} "$<TARGET_FILE:howdy_install_preflight>"
      "$ENV{DESTDIR}" "@PROJECT_BINARY_DIR@/install_destinations-$<CONFIG>.txt"
    RESULT_VARIABLE result
    ERROR_VARIABLE error
  )
  if(NOT result STREQUAL "0")
    message(FATAL_ERROR "Staged install preflight failed: ${error} (${result})")
  endif()
endif()
