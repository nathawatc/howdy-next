FROM docker.io/library/archlinux:latest

# The base image's pacman.conf skips usr/share/i18n/*, so locale sources such as
# th_TH are missing; stop skipping them and reinstall glibc (no --needed) to restore them.
RUN sed -i 's|usr/share/i18n/\*||' /etc/pacman.conf \
	&& pacman -Syu --noconfirm \
		'glibc>=2.36' \
		'cmake>=3.31' \
		acl \
		ccache \
		'clang>=23' \
		curl \
		gcc \
		gettext \
		git \
		libevdev \
		'libinih>=59' \
		make \
		nodejs \
		openssl \
		'opencv>=5.0.0' \
		pam \
		pkgconf \
		qt6-base \
		'yyjson>=0.12.0' \
	&& sed -i 's/^#\(th_TH\.UTF-8 UTF-8\)/\1/' /etc/locale.gen \
	&& locale-gen \
	&& pacman -Scc --noconfirm

LABEL org.opencontainers.image.source="https://github.com/nathawatc/howdy-next" \
	  org.opencontainers.image.description="Howdy Next Arch Linux CI build image"
