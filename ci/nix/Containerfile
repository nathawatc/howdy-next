FROM docker.io/nixos/nix:2.35.3

RUN printf '%s\n' \
		'experimental-features = nix-command flakes' \
		'allow-import-from-derivation = false' \
	>> /etc/nix/nix.conf

WORKDIR /prewarm
COPY flake.nix flake.lock CMakeLists.txt Cargo.lock ./
COPY nix/ ./nix/
# Build and collect in one layer: neither temporary build inputs nor a second
# copy of the base image's Nix store should inflate the published image.
RUN mkdir -p /etc/howdy-nix-ci /nix/var/nix/gcroots \
	&& nix build --no-update-lock-file \
		--out-link /nix/var/nix/gcroots/ci-dependencies \
		path:/prewarm#packages.x86_64-linux.ci-dependencies \
	&& nix build --offline --max-jobs 0 --no-update-lock-file \
		--out-link /nix/var/nix/gcroots/ci-runtime \
		path:/prewarm#packages.x86_64-linux.ci-runtime \
	&& readlink /nix/var/nix/gcroots/ci-dependencies > /etc/howdy-nix-ci/dependencies \
	&& rm -rf /prewarm \
	&& nix-store --gc \
	&& GLIBC_LIB=$(dirname $(find /nix/store -name "ld-linux-x86-64.so.2" | head -n1)) \
	&& GCC_LIB=$(dirname $(find /nix/store -name "libstdc++.so.6" | head -n1)) \
	&& LDCONFIG=$(find /nix/store -name "ldconfig" | head -n1) \
	&& mkdir -p /lib64 /lib /etc "$GLIBC_LIB/../etc" \
	&& ln -sf "$GLIBC_LIB/ld-linux-x86-64.so.2" /lib64/ld-linux-x86-64.so.2 \
	&& ln -sf "$GLIBC_LIB/ld-linux-x86-64.so.2" /lib/ld-linux-x86-64.so.2 \
	&& printf "%s\n%s\n" "$GLIBC_LIB" "$GCC_LIB" > /etc/ld.so.conf \
	&& "$LDCONFIG" -C "$GLIBC_LIB/../etc/ld.so.cache" -f /etc/ld.so.conf \
	&& printf '[safe]\n\tdirectory = *\n' > /etc/gitconfig

ENV PATH="/nix/var/nix/gcroots/ci-runtime/bin:${PATH}"
WORKDIR /

LABEL org.opencontainers.image.source="https://github.com/nathawatc/howdy-next" \
		org.opencontainers.image.description="Howdy Next Nix CI build image"
