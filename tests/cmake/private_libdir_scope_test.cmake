cmake_minimum_required(VERSION 3.31)

# Reads the INSTALL_RPATH of the installed ELF targets as generated by the real build
# and checks that HOWDY_PRIVATE_LIBDIR reaches exactly the two binaries that link
# OpenCV. The setuid helper and the PAM module must never carry a RUNPATH.

foreach(required_variable IN ITEMS HOWDY_PRIVATE_LIBDIR_MANIFEST)
  if(NOT DEFINED ${required_variable} OR "${${required_variable}}" STREQUAL "")
    message(FATAL_ERROR "Missing private libdir test variable: ${required_variable}")
  endif()
endforeach()
if(NOT DEFINED HOWDY_EXPECTED_PRIVATE_LIBDIR)
  set(HOWDY_EXPECTED_PRIVATE_LIBDIR "")
endif()

file(STRINGS "${HOWDY_PRIVATE_LIBDIR_MANIFEST}" manifest_lines)
set(seen "")
set(failures "")
foreach(line IN LISTS manifest_lines)
  if(NOT line MATCHES "^([a-z_]+)=(.*)$")
    string(APPEND failures "\nmalformed manifest line: '${line}'")
    continue()
  endif()
  set(target "${CMAKE_MATCH_1}")
  set(rpath "${CMAKE_MATCH_2}")
  list(APPEND seen "${target}")
  if(target STREQUAL "howdy" OR target STREQUAL "howdy_compare")
    set(expected "${HOWDY_EXPECTED_PRIVATE_LIBDIR}")
  else()
    set(expected "")
  endif()
  if(NOT rpath STREQUAL expected)
    string(APPEND failures "\n${target}: INSTALL_RPATH '${rpath}', expected '${expected}'")
  endif()
endforeach()

foreach(target IN ITEMS howdy howdy_compare howdy_auth_helper pam_howdy)
  if(NOT target IN_LIST seen)
    string(APPEND failures "\n${target}: missing from the manifest")
  endif()
endforeach()

if(NOT failures STREQUAL "")
  message(FATAL_ERROR "Private libdir scope checks failed:${failures}")
endif()
