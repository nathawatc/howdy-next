# Broad, strict clang-tidy policy.
#
# Linux/POSIX boundary policy:
#
# - Header ownership:
#   - C/POSIX header ownership is enforced by misc-include-cleaner instead of deprecated-header
#     replacement, which cannot distinguish standard C use from POSIX declarations.
#   - Dependency implementation headers are never source-level include contracts: glibc/libstdc++
#     bits/**, Linux UAPI asm-generic/**, and Linux-PAM security/_pam_*.h are reached through their
#     public wrappers. Include Cleaner ignores those private providers so it cannot replace public
#     API headers with implementation details, including linkage-sensitive PAM declarations.
#
# - System API boundaries:
#   - Linux/PAM integration necessarily uses fixed system vararg APIs (open/fcntl/ioctl/syslog/
#     prctl/syscall), process-environment APIs, and legacy POSIX interfaces such as
#     glob/readdir/strsignal. Reentrant passwd lookup and owning system-error messages are used
#     where replacements exist.
#   - malloc/free-compatible ownership remains required by PAM and yyjson C ABI contracts. The
#     corresponding blanket checks cannot model those lifecycle/ABI constraints without wrapper-only
#     indirection or allocator mismatches rather than safer code.
#
# General policy:
#
# - All selected general-purpose checks are enforced as errors except:
#   - Compiler-owned diagnostics:
#     - clang-diagnostic-*
#     - readability-misleading-indentation
#   - Repository-wide low-signal style checks:
#     - readability-magic-numbers
#     - readability-identifier-length
#
# - Check conflicts (stronger check wins):
#   - readability-redundant-qualified-alias is disabled. Replacing a namespace-scope alias with a
#     using-declaration conflicts with google-global-names-in-headers for aliases in global-scope
#     test headers, and changes misc-include-cleaner ownership for re-exported aliases such as
#     howdy::test::ScopedFd.
#
# LLVM 23 behavior changes:
#
# - misc-const-correctness.AnalyzeParameters is false. Const-qualifying pointee parameters changes
#   the function type, which breaks the type-erased `void *context` callback and C/PAM ABI
#   signatures used throughout the repository.
# - readability-trailing-comma.SingleLineCommaPolicy is Ignore. The Remove policy misreports empty
#   `{}` arguments followed by a comma and its fix-it deletes the argument separator.
# - zircon-* is disabled with fuchsia-*; zircon-temporary-objects is deprecated in favor of
#   fuchsia-temporary-objects.

InheritParentConfig: false

Checks: >-
  *,
  -clang-diagnostic-*,
  -altera-*,
  -zircon-*,
  -fuchsia-*,
  -llvmlibc-*,
  -readability-misleading-indentation,
  -readability-magic-numbers,
  -cppcoreguidelines-avoid-magic-numbers,
  -readability-identifier-length,
  -readability-redundant-qualified-alias,
  -portability-avoid-pragma-once,
  -llvm-header-guard,
  -llvm-prefer-static-over-anonymous-namespace,
  -modernize-deprecated-headers,
  -hicpp-deprecated-headers,
  -concurrency-mt-unsafe,
  -cppcoreguidelines-pro-type-vararg,
  -hicpp-vararg,
  -cppcoreguidelines-owning-memory,
  -cppcoreguidelines-no-malloc,
  -hicpp-no-malloc


WarningsAsErrors: >-
  *,
  -clang-diagnostic-*


ExcludeHeaderFilterRegex: '(^|.*/)(build[^/]*/|_deps/)|^/usr/(local/)?include/'

SystemHeaders: false
FormatStyle: file

# Project identifier-naming policy.
# Based on the Google C++ Style Guide naming conventions:
# google/styleguide cppguide.html @
# 1809c769de31ba388c755ad15dd057a9ba8531fd, Naming section.
#
# This configuration is the enforcement source of truth where the
# upstream guide permits multiple forms.
CheckOptions:
  misc-include-cleaner.IgnoreHeaders: '(^|.*/)(bits/.*|asm-generic/.*|security/_pam_.*\.h)$'

  misc-const-correctness.AnalyzeParameters: false
  readability-trailing-comma.SingleLineCommaPolicy: Ignore

  readability-identifier-naming.NamespaceCase: lower_case
  readability-identifier-naming.ClassCase: CamelCase
  readability-identifier-naming.StructCase: CamelCase
  readability-identifier-naming.UnionCase: CamelCase
  readability-identifier-naming.EnumCase: CamelCase
  readability-identifier-naming.TypeAliasCase: CamelCase
  readability-identifier-naming.TypedefCase: CamelCase
  readability-identifier-naming.ConceptCase: CamelCase
  readability-identifier-naming.TypeTemplateParameterCase: CamelCase
  readability-identifier-naming.ValueTemplateParameterCase: lower_case

  readability-identifier-naming.VariableCase: lower_case
  readability-identifier-naming.ParameterCase: lower_case
  readability-identifier-naming.PublicMemberCase: lower_case
  readability-identifier-naming.PrivateMemberCase: lower_case
  readability-identifier-naming.PrivateMemberSuffix: _
  readability-identifier-naming.ProtectedMemberCase: lower_case
  readability-identifier-naming.ProtectedMemberSuffix: _

  readability-identifier-naming.FunctionCase: CamelCase
  readability-identifier-naming.FunctionIgnoredRegexp: '^(main|pam_sm_(authenticate|acct_mgmt|chauthtok|open_session|close_session|setcred)|real_initgroups|wrap_initgroups|pam_get_item)$'
  readability-identifier-naming.MethodCase: CamelCase
  readability-identifier-naming.ConstexprFunctionCase: CamelCase

  readability-identifier-naming.GlobalConstantCase: CamelCase
  readability-identifier-naming.GlobalConstantPrefix: k
  readability-identifier-naming.StaticConstantCase: CamelCase
  readability-identifier-naming.StaticConstantPrefix: k
  readability-identifier-naming.ClassConstantCase: CamelCase
  readability-identifier-naming.ClassConstantPrefix: k

  readability-identifier-naming.GlobalConstexprVariableCase: CamelCase
  readability-identifier-naming.GlobalConstexprVariablePrefix: k
  readability-identifier-naming.StaticConstexprVariableCase: CamelCase
  readability-identifier-naming.StaticConstexprVariablePrefix: k
  readability-identifier-naming.ClassConstexprCase: CamelCase
  readability-identifier-naming.ClassConstexprPrefix: k

  readability-identifier-naming.LocalConstantCase: lower_case
  readability-identifier-naming.LocalConstexprVariableCase: lower_case

  readability-identifier-naming.EnumConstantCase: CamelCase
  readability-identifier-naming.EnumConstantPrefix: k

  readability-identifier-naming.MacroDefinitionCase: UPPER_CASE
  readability-identifier-naming.MacroDefinitionIgnoredRegexp: '^_GNU_SOURCE$'
